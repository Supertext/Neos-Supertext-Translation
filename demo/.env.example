# Variables for the Neos demo container (set them as Railway service variables).
# Never commit real values.

# Database (Railway: reference the MariaDB service's variables)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Demo accounts, created on every start if missing (the e-mail is the Neos username)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.supertext.com/v1/

# Railway: Apache port (match the domain's target port)
PORT=8080
