# Variables for the Neos demo container (set them as Railway service variables).
# Never commit real values.

# Database (Railway: reference the MariaDB service's variables)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Demo accounts, created on every start if missing (the e-mail is the Neos username)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext — no account yet? Create one: https://www.supertext.com/person/en/account/signin
# API key: supertext.com > Integrations > API (requires the Admin role): https://www.supertext.com/en/integrations/api
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.supertext.com/v1/
# Optional: another review service for languages with "Translation review" ticked under
# Administration > Supertext (default: Supertext's review service)
# SUPERTEXT_REVIEW_URL=http://localhost:3000/v1/
# Send version information to Supertext (site URL, package/Neos/PHP versions, API key check
# result; no content, no key): on by default, 0 turns it off.
# SUPERTEXT_VERSION_REPORTS=0

# Railway: Apache port (match the domain's target port)
PORT=8080
