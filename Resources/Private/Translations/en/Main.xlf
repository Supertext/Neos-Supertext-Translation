<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file original="" product-name="Supertext.NeosTranslation" source-language="en" datatype="plaintext">
		<body>
			<trans-unit id="module.label" xml:space="preserve">
				<source>Supertext</source>
			</trans-unit>
			<trans-unit id="module.description" xml:space="preserve">
				<source>Export pages for translation as XLIFF or HTML files and import the translated files.</source>
			</trans-unit>
			<trans-unit id="export.title" xml:space="preserve">
				<source>Export for translation</source>
			</trans-unit>
			<trans-unit id="export.hint" xml:space="preserve">
				<source>Download the page's texts as a file for a translation tool, a translator or Supertext's web app. Import the translated file again under Import translation.</source>
			</trans-unit>
			<trans-unit id="export.page" xml:space="preserve">
				<source>Page (with its content)</source>
			</trans-unit>
			<trans-unit id="export.source" xml:space="preserve">
				<source>Source language: {0}. The texts are taken from your workspace.</source>
			</trans-unit>
			<trans-unit id="export.languages" xml:space="preserve">
				<source>Languages</source>
			</trans-unit>
			<trans-unit id="export.format" xml:space="preserve">
				<source>File format</source>
			</trans-unit>
			<trans-unit id="export.format.xliff" xml:space="preserve">
				<source>XLIFF 1.2 (for translation tools)</source>
			</trans-unit>
			<trans-unit id="export.format.html" xml:space="preserve">
				<source>HTML (one language per file)</source>
			</trans-unit>
			<trans-unit id="export.download" xml:space="preserve">
				<source>Download file</source>
			</trans-unit>
			<trans-unit id="export.noPages" xml:space="preserve">
				<source>There are no pages to export.</source>
			</trans-unit>
			<trans-unit id="export.noTargets" xml:space="preserve">
				<source>The site has no other language to translate into.</source>
			</trans-unit>
			<trans-unit id="import.title" xml:space="preserve">
				<source>Import translation</source>
			</trans-unit>
			<trans-unit id="import.hint" xml:space="preserve">
				<source>Upload a file exported with Export for translation (any page, at most 10 MB). The translations are saved in your workspace, like translations made with Supertext: review and publish them as usual.</source>
			</trans-unit>
			<trans-unit id="import.file" xml:space="preserve">
				<source>Translated file (XLIFF or HTML)</source>
			</trans-unit>
			<trans-unit id="import.includeChanged" xml:space="preserve">
				<source>Also import texts whose source changed since the export</source>
			</trans-unit>
			<trans-unit id="import.noFile" xml:space="preserve">
				<source>Choose a file to import.</source>
			</trans-unit>
			<trans-unit id="import.result" xml:space="preserve">
				<source>Result of the import</source>
			</trans-unit>
			<trans-unit id="import.job" xml:space="preserve">
				<source>{0} → {1}: {2}</source>
			</trans-unit>
			<trans-unit id="import.publish" xml:space="preserve">
				<source>Review the translations in your workspace and publish them.</source>
			</trans-unit>
			<trans-unit id="summary.ok" xml:space="preserve">
				<source>Imported: {0}</source>
			</trans-unit>
			<trans-unit id="summary.changed" xml:space="preserve">
				<source>Skipped, source changed since the export: {0}</source>
			</trans-unit>
			<trans-unit id="summary.untranslated" xml:space="preserve">
				<source>Not translated in the file: {0}</source>
			</trans-unit>
			<trans-unit id="summary.invalid" xml:space="preserve">
				<source>Formatting changed, not imported: {0}</source>
			</trans-unit>
			<trans-unit id="summary.missing" xml:space="preserve">
				<source>Not in the file: {0}</source>
			</trans-unit>
			<trans-unit id="error.nothing_to_translate" xml:space="preserve">
				<source>Nothing to translate.</source>
			</trans-unit>
			<trans-unit id="error.invalid_request" xml:space="preserve">
				<source>Choose at least one language (exactly one for HTML).</source>
			</trans-unit>
			<trans-unit id="error.invalid_file" xml:space="preserve">
				<source>This file isn't a valid XLIFF or HTML translation file.</source>
			</trans-unit>
			<trans-unit id="error.missing_metadata" xml:space="preserve">
				<source>This file wasn't exported by the Supertext package, or its header was removed.</source>
			</trans-unit>
			<trans-unit id="error.too_large" xml:space="preserve">
				<source>The file is too large (at most 10 MB).</source>
			</trans-unit>
			<trans-unit id="error.other_system" xml:space="preserve">
				<source>This file belongs to another system ({0}).</source>
			</trans-unit>
			<trans-unit id="error.not_found" xml:space="preserve">
				<source>The page this file was exported from no longer exists.</source>
			</trans-unit>
			<trans-unit id="error.no_language" xml:space="preserve">
				<source>The site has no language {0}.</source>
			</trans-unit>
			<trans-unit id="mapping.module.label" xml:space="preserve">
				<source>Supertext</source>
			</trans-unit>
			<trans-unit id="mapping.module.description" xml:space="preserve">
				<source>Choose the Supertext language of each language of your sites.</source>
			</trans-unit>
			<trans-unit id="mapping.title" xml:space="preserve">
				<source>Languages</source>
			</trans-unit>
			<trans-unit id="mapping.hint" xml:space="preserve">
				<source>Choose which Supertext language each language of your sites is translated into and from. Where the choice is obvious, Supertext's suggestion is preselected (de → German (Germany)); a language without a suggestion can't be translated until you choose one.</source>
			</trans-unit>
			<trans-unit id="mapping.language" xml:space="preserve">
				<source>Language</source>
			</trans-unit>
			<trans-unit id="mapping.code" xml:space="preserve">
				<source>Supertext language</source>
			</trans-unit>
			<trans-unit id="mapping.politeness" xml:space="preserve">
				<source>Form of address</source>
			</trans-unit>
			<trans-unit id="mapping.politeness.default" xml:space="preserve">
				<source>Default</source>
			</trans-unit>
			<trans-unit id="mapping.politeness.more" xml:space="preserve">
				<source>Formal</source>
			</trans-unit>
			<trans-unit id="mapping.politeness.less" xml:space="preserve">
				<source>Informal</source>
			</trans-unit>
			<trans-unit id="mapping.choose" xml:space="preserve">
				<source>— choose —</source>
			</trans-unit>
			<trans-unit id="mapping.suggested" xml:space="preserve">
				<source>Supertext's suggestion</source>
			</trans-unit>
			<trans-unit id="mapping.none" xml:space="preserve">
				<source>No suggestion: choose a Supertext language, otherwise this language can't be translated.</source>
			</trans-unit>
			<trans-unit id="mapping.fromSettings" xml:space="preserve">
				<source>Set in Settings.yaml (Supertext.NeosTranslation.languages.{0}.code)</source>
			</trans-unit>
			<trans-unit id="mapping.politenessFromSettings" xml:space="preserve">
				<source>Set in Settings.yaml (Supertext.NeosTranslation.languages.{0}.politeness)</source>
			</trans-unit>
			<trans-unit id="mapping.save" xml:space="preserve">
				<source>Save</source>
			</trans-unit>
			<trans-unit id="mapping.saved" xml:space="preserve">
				<source>The languages were saved.</source>
			</trans-unit>
			<trans-unit id="mapping.invalid" xml:space="preserve">
				<source>Not saved: no valid Supertext language chosen for {0}.</source>
			</trans-unit>
			<trans-unit id="mapping.noLanguages" xml:space="preserve">
				<source>Your content repository has no language dimension "{0}" (setting Supertext.NeosTranslation.languageDimension).</source>
			</trans-unit>
			<trans-unit id="mapping.version" xml:space="preserve">
				<source>Supertext Translation for Neos {0}</source>
			</trans-unit>
			<trans-unit id="mapping.review" xml:space="preserve">
				<source>Translation review</source>
			</trans-unit>
			<trans-unit id="mapping.review.help" xml:space="preserve">
				<source>Translation review: translations into a ticked language go through Supertext's review service, so reviewers can check and correct them on the website with the Supertext Localization Review extension. Their corrections are used the next time the page is translated.</source>
			</trans-unit>
			<trans-unit id="mapping.review.off" xml:space="preserve">
				<source>Translation review is off for all languages: the setting Supertext.NeosTranslation.reviewUrl is empty.</source>
			</trans-unit>
			<trans-unit id="mapping.reviewFromSettings" xml:space="preserve">
				<source>Set in Settings.yaml (Supertext.NeosTranslation.languages.{0}.review)</source>
			</trans-unit>
		</body>
	</file>
</xliff>
