# PHPStan: see docs/DEVELOPER.md → Code quality and security checks.
# Needs Neos's classes: CI installs the demo's locked Neos and passes
# --autoload-file=demo/Packages/Libraries/autoload.php.
parameters:
    level: 5
    paths:
        - Classes
    # The bundled Supertext SDK and Supertext Plugin Health: known to PHPStan, not analysed
    # (fix them in their own repositories).
    scanDirectories:
        - lib/supertext-sdk/src
        - lib/supertext-plugin-health/src
